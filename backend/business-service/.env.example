ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://ams_business:ams_business@localhost:5433/ams_business

AUTH_SERVICE_BASE_URL=http://localhost:8080
JWT_JWKS_URL=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=ams-auth-service
JWT_AUDIENCE=ams-business-service

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=business-service
KAFKA_TOPIC_PREFIX=ams
KAFKA_CONSUMER_GROUP=business-service-notification

REDIS_URL=redis://localhost:6379/0

# Gemini is used for document, ID, vehicle, and other file extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

CORS_ALLOW_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
GRN_USERNAME=grn
GRN_PASSWORD=123456
PROCUREMENT_USERNAME=procurement
PROCUREMENT_PASSWORD=procur123
FINANCE_USERNAME=finance
FINANCE_PASSWORD=finance123
WAREHOUSE_USERNAME=warehouse
WAREHOUSE_PASSWORD=warehouse123
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manager123
ASSEMBLY_MANAGER_USERNAME=assembly_manager
ASSEMBLY_MANAGER_PASSWORD=assembly123
GATE_ENTRY_USERNAME=gate_entry
GATE_ENTRY_PASSWORD=gate123
SUPPLIER_USERNAME=supplier
SUPPLIER_PASSWORD=supplier123
DISPATCH_USERNAME=dispatch
DISPATCH_PASSWORD=dispatch123

# ========================================================================================
# SMTP Email Configuration - REQUIRED for RFQ and notification emails
# ========================================================================================
# Email sending requires SMTP credentials. Leave empty to disable email (logs only).

# SMTP server hostname (e.g., smtp.gmail.com, smtp.outlook.com)
EMAIL_HOST=smtp.gmail.com

# SMTP port: 465 (SSL/implicit TLS, fastest for Gmail) or 587 (STARTTLS)
EMAIL_PORT=587

# Fail unavailable SMTP connections quickly instead of delaying the workflow.
EMAIL_TIMEOUT_SECONDS=8

# Email account username (your email address)
# For Gmail: use your full Gmail address (e.g., yourname@gmail.com)
# For Outlook: use your Outlook address (e.g., yourname@outlook.com)
EMAIL_HOST_USER=harshavardhandevang@gmail.com

# Email account password or app-specific password
# ⚠️  IMPORTANT SECURITY NOTES:
#    • NEVER use your real Gmail/Outlook password in this file
#    • For Gmail with 2FA enabled (RECOMMENDED):
#      1. Enable 2-Factor Authentication: https://myaccount.google.com/security
#      2. Generate App Password: https://myaccount.google.com/apppasswords
#      3. Use the 16-character app password below
#    • For Outlook: Use app password if 2FA enabled, otherwise regular password
#    • For local testing: Can use regular password if 2FA disabled (not recommended for prod)
EMAIL_HOST_PASSWORD=your_app_password

# Display name shown in the "From" field of emails
EMAIL_FROM_NAME=KaizenX Procurement

